{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Portio",
  "version": "0.0.1",
  "identifier": "io.portio.desktop",
  "build": {
    "frontendDist": "../../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Portio",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "decorations": false,
        "theme": "Dark",
        "backgroundColor": "#0D1014",
        "visible": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
